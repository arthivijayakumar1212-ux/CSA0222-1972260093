#include <stdio.h>

#define RUPEES_TO_PAISE(r) ((r) * 100)
#define SQUARE(x) ((x) * (x))
#define MAX(a, b) ((a) > (b) ? (a) : (b))

static inline int square_int(int x)
{
    return x * x;
}

static inline int max_int(int a, int b)
{
    return a > b ? a : b;
}

int main(void)
{
    int a = 5;
    int b = 8;

    printf("500 rupees in paise: %d\n", RUPEES_TO_PAISE(5));
    printf("Square of (a + 1): %d\n", SQUARE(a + 1));
    printf("Maximum using macro: %d\n", MAX(a, b));
    printf("Square using function: %d\n", square_int(a));
    printf("Maximum using function: %d\n", max_int(a, b));

    return 0;
}
